# Copy to .env.local and fill in. Never commit .env.local.

# --- Tap Payments (https://developers.tap.company) ---
#
# The three values below are Tap's SHARED public test credentials, published
# for anyone starting an integration:
#   https://developers.tap.company/reference/testing-keys
# They run in test mode only (no real money moves), and every developer using
# them shares one test merchant, so charges you create are visible to others.
# Swap in your own test keys from the Tap dashboard once you have an account,
# and your live keys (sk_live_ / pk_live_) only in production.

# Server only. Creates and retrieves charges and signs webhooks. Never prefix
# it with NEXT_PUBLIC_. A key starting sk_live_ turns test mode (and its
# banner and developer notes) off.
TAP_SECRET_KEY=sk_test_XKokBfNWv6FIYuTMg5sLPjhJ

# Browser side. The Tap card field uses it to turn the card into a token.
NEXT_PUBLIC_TAP_PUBLIC_KEY=pk_test_EtHFV4BuPQokJT6jiROls87Y

# Your merchant id from Tap's dashboard. The card field and the Apple Pay
# button send it. 599424 is Tap's shared test merchant.
TAP_MERCHANT_ID=599424

# --- Where Tap sends the customer back and posts webhooks ---
#
# Leave empty locally: the app uses the address the request came in on.
# Set it to your public HTTPS URL behind a tunnel (Tap can't post to
# localhost) and in production, without a trailing slash.
# APP_URL=https://your-tunnel.trycloudflare.com

# --- Payment methods beyond cards (see "Payment methods" in the README) ---
#
# Each is off until set to 1, because each needs setup outside this code.
# The checkout page reads them too, hence NEXT_PUBLIC_. Restart the dev server
# after changing one.
NEXT_PUBLIC_TAP_APPLE_PAY=
NEXT_PUBLIC_TAP_STC_PAY=
NEXT_PUBLIC_TAP_KNET=

# --- Hosting under a path, and a shared order store (optional) ---
#
# Both empty for a normal install. The hosted demo at
# nextjs-rtl.codefolio.dev/demo sets them: the whole app under /demo, the Pay
# now action accepting posts that arrive through that domain, and APP_URL
# (above) set to https://nextjs-rtl.codefolio.dev/demo.
NEXT_PUBLIC_BASE_PATH=
SERVER_ACTIONS_ALLOWED_ORIGINS=

# Orders are kept in memory unless a Redis store is set, which any deployment
# on serverless needs (instances don't share memory). Upstash's REST URL and
# token; Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN,
# which work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Demo order ---
#
# SAR (the default) or KWD. KNET only takes Kuwaiti dinars, so set KWD to try it.
SAMPLE_CURRENCY=SAR
