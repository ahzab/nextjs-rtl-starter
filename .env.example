# Copy to .env.local and fill in. Never commit .env.local.

# Tap Payments (https://developers.tap.company)
#
# The values below are Tap's SHARED public test credentials, published for
# anyone starting an integration:
#   https://developers.tap.company/reference/testing-keys
# They run in test mode only (no real money moves), and every developer using
# them shares one test merchant, so charges you create are visible to others.
# Swap in your own test keys from the Tap dashboard once you have an account,
# and your live keys (sk_live_/pk_live_) only in production.

# Server side only: every API call (create/retrieve charge, webhook check).
TAP_SECRET_KEY=sk_test_XKokBfNWv6FIYuTMg5sLPjhJ

# Browser side: the Tap card field uses it to tokenize the card.
NEXT_PUBLIC_TAP_PUBLIC_KEY=pk_test_EtHFV4BuPQokJT6jiROls87Y

# Tap's shared test merchant.
TAP_MERCHANT_ID=599424
